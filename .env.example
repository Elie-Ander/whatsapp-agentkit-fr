# AgentKit : variables d'environnement
# Copie ce fichier sous le nom .env et remplis tes informations :
#   cp .env.example .env
#
# Claude Code t'aide à remplir ces valeurs pendant la configuration.
# N'envoie JAMAIS le fichier .env sur GitHub.

# ── Anthropic ──────────────────────────────────────────────
# À obtenir sur : https://platform.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modèle de Claude. Par défaut : claude-sonnet-5
#   claude-opus-5     le plus capable                  5 $ / 25 $ par million de tokens
#   claude-sonnet-5   l'équilibré (par défaut)         3 $ / 15 $
#   claude-haiku-4-5  le moins cher et le plus rapide  1 $ / 5 $
ANTHROPIC_MODEL=claude-sonnet-5

# Effort de raisonnement : low | medium | high
# Laisse vide pour ne pas envoyer le paramètre (les anciens modèles ne l'acceptent pas).
ANTHROPIC_EFFORT=low

# Optionnel. Plafond de tokens par réponse, 4096 par défaut. Attention : sur les
# modèles actuels, le raisonnement interne compte aussi dans ce plafond.
# ANTHROPIC_MAX_TOKENS=4096

# ── Fournisseur WhatsApp ───────────────────────────────────
# Choix possibles : zernio | meta
WHATSAPP_PROVIDER=

# ── Zernio (si WHATSAPP_PROVIDER=zernio) ───────────────────
# Créer un compte et connecter WhatsApp sur : https://zernio.com
# La clé API se génère dans Settings -> API Keys (elle commence par "sk_")
ZERNIO_API_KEY=
# Le webhook secret, c'est toi qui l'inventes. Il sert à vérifier que les
# messages viennent de Zernio et pas de quelqu'un qui connaît ton URL.
ZERNIO_WEBHOOK_SECRET=
# Optionnel : ne sert qu'à vérifier la connexion au démarrage.
# Pour répondre, l'account id vient du webhook lui-même.
ZERNIO_ACCOUNT_ID=
# Optionnel : seulement si tu dois viser une autre URL. Laisse-la en commentaire
# pour utiliser l'URL habituelle, https://zernio.com/api/v1
# ZERNIO_BASE_URL=

# ── Meta Cloud API (si WHATSAPP_PROVIDER=meta) ─────────────
# À configurer sur : https://developers.facebook.com
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=agentkit-verify
# META_APP_SECRET=
# META_API_VERSION=v25.0

# ── Serveur ────────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Base de données ────────────────────────────────────────
# En local (SQLite) :
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# En production (PostgreSQL sur Railway) :
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
